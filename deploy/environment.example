# Copy to /etc/start1921/start1921.env, owned by root with mode 600.
# Use this file with docker compose --env-file as well as app env_file.
START1921_ENV_FILE=/etc/start1921/start1921.env
START1921_STORAGE_ROOT=/opt/start1921/runtime
# Use a release-specific image tag, normally the source Git commit.
START1921_APP_IMAGE=start1921:local
START1921_POSTGRES_IMAGE=postgres:18.6-bookworm
# Generate two distinct values with `openssl rand -hex 32`.
# Keep PostgreSQL password hexadecimal: compose places it in a connection URL.
START1921_POSTGRES_PASSWORD=
START1921_QDRANT_API_KEY=

# Existing provider settings can be transferred here; never commit the key.
DEEPSEEK_API_KEY=
HISTORY_AGENT_LLM_BASE_URL=https://api.deepseek.com
HISTORY_AGENT_LLM_MODEL=deepseek-v4-pro
HISTORY_AGENT_LLM_THINKING=false
HISTORY_AGENT_LLM_REASONING_EFFORT=high
HISTORY_AGENT_LLM_MAX_TOKENS=5000
HISTORY_AGENT_REQUEST_TIMEOUT_SECONDS=90
HISTORY_AGENT_LLM_QUERY_PLANNING=true
HISTORY_AGENT_LLM_QUERY_PLANNER_MODEL=deepseek-v4-flash
HISTORY_AGENT_LLM_QUERY_PLANNER_MAX_TOKENS=700
HISTORY_AGENT_LLM_QUERY_PLANNER_TIMEOUT_SECONDS=20
