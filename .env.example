# All paths may be absolute or relative to the project root.
HISTORY_AGENT_DOCS_DIR=docs
HISTORY_AGENT_DATA_DIR=data
# Required PostgreSQL main database. There is no local-file fallback.
HISTORY_AGENT_DATABASE_URL=
# Defaults to DATABASE_URL.
HISTORY_AGENT_CONVERSATION_DATABASE_URL=
# Defaults to DATABASE_URL; set separately to use another PostgreSQL database.
HISTORY_AGENT_KEYWORD_DATABASE_URL=
# Required Qdrant service. There is no embedded backend.
HISTORY_AGENT_QDRANT_URL=
HISTORY_AGENT_QDRANT_API_KEY=
HISTORY_AGENT_QDRANT_TIMEOUT_SECONDS=30
HISTORY_AGENT_CATALOG_PATH=config/corpus_catalog.json
HISTORY_AGENT_LOG_LEVEL=INFO
HISTORY_AGENT_ENVIRONMENT=development

# Research boundary. Evidence outside this range is excluded by default.
HISTORY_AGENT_RESEARCH_START=1921-01-01
HISTORY_AGENT_RESEARCH_END=1978-12-31

# DeepSeek V4 generation. The standard DEEPSEEK_API_KEY name is also accepted.
HISTORY_AGENT_LLM_BASE_URL=https://api.deepseek.com
HISTORY_AGENT_LLM_MODEL=deepseek-v4-pro
HISTORY_AGENT_LLM_THINKING=false
HISTORY_AGENT_LLM_REASONING_EFFORT=high
HISTORY_AGENT_LLM_MAX_TOKENS=5000
# End-to-end deadline and shared admission limit for planner + answer generation.
HISTORY_AGENT_REQUEST_TIMEOUT_SECONDS=90
HISTORY_AGENT_LLM_MAX_CONCURRENCY=4
# Understand free-form questions before hybrid retrieval; uses non-thinking JSON output.
HISTORY_AGENT_LLM_QUERY_PLANNING=true
HISTORY_AGENT_LLM_QUERY_PLANNER_MODEL=deepseek-v4-flash
HISTORY_AGENT_LLM_QUERY_PLANNER_MAX_TOKENS=2000
HISTORY_AGENT_LLM_QUERY_PLANNER_TIMEOUT_SECONDS=20
# Delivery-time citation check.
#   s1       - remove unverifiable [E#] ids and contradictory page numbers
#   s1_dates - also add a review note when a date is absent from the cited chunk
#              (dates are never rewritten), default
#   off      - deliver the model answer unchanged
HISTORY_AGENT_CITATION_CHECK=s1_dates
DEEPSEEK_API_KEY=
