# Build from an allowlist: runtime data, PDFs, .env, Git and local virtualenvs
# must never enter an image layer or the build context.
**
!pyproject.toml
!uv.lock
!README.md
!app/
!app/**
!config/
!config/*.json
!config/jieba_userdict.txt
!config/entities/
!config/entities/*.json
!config/entities/*.jsonl
!deploy/
!deploy/Dockerfile
!deploy/healthcheck.py
!deploy/check_image.py
!deploy/keyword_upgrade.py
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
